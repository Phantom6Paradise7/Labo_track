<%- include('../partials/header') %>

<div style="max-width: 540px; margin: 2rem auto;">
  <div class="card" style="padding: 2rem; border-top: 4px solid var(--primary-600);">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <div class="mono-label">REGISTRATION</div>
      <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--stone-900); margin-top: 0.5rem;">
        Join LaboTrack Platform
      </h2>
      <p style="font-size: 0.8125rem; color: var(--stone-500); margin-top: 0.25rem;">
        Register your institutional role to access inventory and requisitions.
      </p>
    </div>

    <!-- Frontend Password Format & Length Alert -->
    <div id="frontendPasswordError" class="alert alert-danger" style="display: none; font-size: 0.8125rem; padding: 0.75rem 1rem;"></div>

    <form id="registerForm" action="/auth/register" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="form-group">
        <label class="form-label" for="name">Full Name *</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Dr. Jane Doe / John Smith" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Institutional Email Address *</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="name@university.edu" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="role">Assign Institutional Role *</label>
        <select class="form-control filter-select" id="role" name="role" required style="width: 100%;" onchange="handleRoleChange(this.value)">
          <option value="admin">System Administrator (Full Control)</option>
          <option value="requester">Staff / Student (Requester)</option>
          <option value="lab_incharge">Lab In-charge (Issue & Inspection)</option>
        </select>
        <small style="color: var(--stone-400); font-size: 0.725rem; display: block; margin-top: 4px;">
          Note: User accounts are permanently bound to their designated role.
        </small>
      </div>

      <div class="form-group" id="deptGroup">
        <label class="form-label" for="department">Department / Division</label>
        <input type="text" class="form-control" id="department" name="department" placeholder="e.g. Molecular Biology, Physics, Robotics">
      </div>

      <div class="form-group" id="idGroup" style="display: none;">
        <label class="form-label" for="studentOrStaffId">Student / Staff ID</label>
        <input type="text" class="form-control" id="studentOrStaffId" name="studentOrStaffId" placeholder="e.g. STU-8821 or STF-1049">
      </div>

      <div class="form-group" id="companyGroup" style="display: none;">
        <label class="form-label" for="supplierCompany">Supplier Organization / Vendor Name</label>
        <input type="text" class="form-control" id="supplierCompany" name="supplierCompany" placeholder="e.g. Scientific Instruments Ltd.">
      </div>

      <!-- Password Field with Client-Side Authentication UI -->
      <div class="form-group">
        <label class="form-label" for="password">Create Password *</label>
        <input type="password" class="form-control" id="password" name="password" placeholder="Min. 8 chars with uppercase, number & symbol" required>

        <!-- Live Password Strength Meter -->
        <div class="pw-strength-bar">
          <div id="pwStrengthFill" class="pw-strength-fill"></div>
        </div>

        <!-- Client-Side Realtime Checklist -->
        <div class="password-criteria-box">
          <div style="font-weight: 600; color: var(--stone-700); margin-bottom: 4px;">Frontend Format Validation Rules:</div>
          <div class="criteria-item invalid" id="rule-length">
            <span class="rule-icon">○</span> At least 8 characters in length
          </div>
          <div class="criteria-item invalid" id="rule-upper">
            <span class="rule-icon">○</span> At least 1 uppercase letter (A-Z)
          </div>
          <div class="criteria-item invalid" id="rule-number">
            <span class="rule-icon">○</span> At least 1 number (0-9)
          </div>
          <div class="criteria-item invalid" id="rule-special">
            <span class="rule-icon">○</span> At least 1 special character (!@#$%^&*...)
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.65rem; margin-top: 0.75rem;">
        Complete Registration
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.8125rem; color: var(--stone-500);">
      Already registered? <a href="/auth/login" style="color: var(--primary-600); font-weight: 600; text-decoration: none;">Sign in here</a>
    </div>
  </div>
</div>

<script>
function handleRoleChange(role) {
  const companyGroup = document.getElementById('companyGroup');
  const idGroup = document.getElementById('idGroup');
  if (!idGroup) return;

  if (role === 'admin') {
    idGroup.style.display = 'none';
    if (companyGroup) companyGroup.style.display = 'none';
  } else if (role === 'supplier') {
    idGroup.style.display = 'none';
    if (companyGroup) companyGroup.style.display = 'block';
  } else {
    // requester, staff, student, lab_incharge
    idGroup.style.display = 'block';
    if (companyGroup) companyGroup.style.display = 'none';
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const roleSelect = document.getElementById('role');
  if (roleSelect) {
    handleRoleChange(roleSelect.value);
    roleSelect.addEventListener('change', (e) => handleRoleChange(e.target.value));
  }
});
</script>

<%- include('../partials/footer') %>
