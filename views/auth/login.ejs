<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 2rem auto;">
  <div class="card" style="padding: 2rem; border-top: 4px solid var(--primary-600);">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <div class="mono-label">PORTAL LOGIN</div>
      <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 700; color: var(--stone-900); margin-top: 0.5rem;">
        Sign in to LaboTrack
      </h2>
      <p style="font-size: 0.8125rem; color: var(--stone-500); margin-top: 0.25rem;">
        Select your designated role to enter the institutional laboratory portal.
      </p>
    </div>

    <!-- Frontend Password Error Alert (Direct Client-Side Feedback) -->
    <div id="frontendPasswordError" class="alert alert-danger" style="display: none; padding: 0.65rem 1rem; font-size: 0.8125rem;"></div>

    <form id="loginForm" action="/auth/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="form-group">
        <label class="form-label" for="role">Select Designated Role *</label>
        <select class="form-control filter-select" id="role" name="role" required style="width: 100%;">
          <option value="admin">System Administrator (Full Control)</option>
          <option value="requester">Staff / Student (Requester)</option>
          <option value="lab_incharge">Lab In-charge (Issue & Inspection)</option>
        </select>
        <small style="color: var(--stone-400); font-size: 0.725rem; display: block; margin-top: 4px;">
          Note: Accounts are strictly locked to their designated role.
        </small>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Institutional Email Address *</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="e.g. scientist@labotrack.edu" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password *</label>
        <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
        <small style="color: var(--stone-400); font-size: 0.725rem; display: block; margin-top: 4px;">
          Client-side password validation requires at least 8 characters.
        </small>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.65rem; margin-top: 0.5rem;">
        Sign In to Laboratory
      </button>
    </form>

    <!-- Quick Demo Role Switcher (Visible ONLY in non-production / development) -->
    <% if (typeof showDemoCreds !== 'undefined' ? showDemoCreds : (process.env.NODE_ENV !== 'production' || process.env.SHOW_DEMO_CREDS === 'true')) { %>
    <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px dashed var(--stone-200);">
      <div style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--stone-400); text-transform: uppercase; margin-bottom: 8px; text-align: center;">
        ⚡ 1-Click Demo Credentials (Dev Only)
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('admin@labotrack.edu', 'AdminPassword123!', 'admin')">
          ⚙️ Admin
        </button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('incharge@labotrack.edu', 'InchargePassword123!', 'lab_incharge')">
          🔬 Lab In-charge
        </button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemo('requester@labotrack.edu', 'RequesterPassword123!', 'requester')">
          🎓 Staff / Student
        </button>
      </div>
    </div>
    <% } %>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.8125rem; color: var(--stone-500);">
      Don't have an account? <a href="/auth/register" style="color: var(--primary-600); font-weight: 600; text-decoration: none;">Join Lab Portal</a>
    </div>
  </div>
</div>

<script>
function fillDemo(email, pass, role) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = pass;
  document.getElementById('role').value = role;
  const errorBox = document.getElementById('frontendPasswordError');
  if (errorBox) errorBox.style.display = 'none';
  document.getElementById('password').classList.remove('is-invalid');
}
</script>

<%- include('../partials/footer') %>
