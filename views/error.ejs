<%- include('partials/header') %>

<div style="max-width: 600px; margin: 4rem auto; text-align: center;">
  <div class="mono-label" style="margin-bottom: 1rem;">SYSTEM NOTICE</div>
  <h1 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 800; color: var(--stone-900); margin-bottom: 1rem;">
    <%= typeof title !== 'undefined' ? title : 'Error Occurred' %>
  </h1>
  <p style="color: var(--stone-600); font-size: 1rem; margin-bottom: 2rem; line-height: 1.6;">
    <%= typeof message !== 'undefined' ? message : 'The requested resource encountered an issue.' %>
  </p>

  <div style="display: flex; justify-content: center; gap: 12px;">
    <a href="/dashboard" class="btn btn-primary">Return to Dashboard</a>
    <a href="/auth/login" class="btn btn-secondary">Switch Role / Sign In</a>
  </div>
</div>

<%- include('partials/footer') %>
